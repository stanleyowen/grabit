# Copy to /etc/video-downloader/env on the server (or server/.env for `npm run dev`).
# Every value below is optional; defaults are shown.

# --- Network ---------------------------------------------------------------
HOST=127.0.0.1              # keep on loopback behind nginx; never expose Node directly
PORT=3003
# Which proxies to trust for the client IP (rate limits are per IP).
#   loopback  -> nginx on the same box (default)
#   2         -> two hops, e.g. Netlify proxy -> nginx -> node
TRUST_PROXY=loopback
# Comma-separated browser origins allowed to call the API directly (CORS).
# Leave empty if the frontend only reaches the API through a same-origin proxy.
CORS_ORIGINS=

# --- Files -----------------------------------------------------------------
DOWNLOADS_DIR=/var/lib/video-downloader/downloads
# Let nginx stream files (sendfile) instead of Node. Must match nginx's internal location.
X_ACCEL_PREFIX=
FILE_TTL_MS=1200000         # finished files are kept (and shared) for 20 min
MIN_FREE_DISK_MB=2048       # refuse new jobs below this much free disk
MAX_FILESIZE=4G             # per-file cap passed to yt-dlp

# --- Capacity --------------------------------------------------------------
MAX_CONCURRENT_DOWNLOADS=   # default: CPU cores (2..8)
MAX_DOWNLOAD_QUEUE_SIZE=500
MAX_ACTIVE_JOBS_PER_CLIENT=6
INFO_CONCURRENCY=           # default: 2 x CPU cores
INFO_CACHE_TTL_MS=900000
PLAYLIST_LIMIT=200
DOWNLOAD_TIMEOUT_MS=2700000
DOWNLOAD_RETRY_LIMIT=1

# --- Per-IP rate limits (requests per minute) ------------------------------
RL_INFO_PER_MIN=30
RL_JOBS_PER_MIN=60
RL_STATUS_PER_MIN=600
RL_FILES_PER_MIN=60

# --- yt-dlp ----------------------------------------------------------------
YTDLP_PATH=/usr/local/bin/yt-dlp
# Restrict to these sites (suffix match), e.g. youtube.com,vimeo.com.
# Empty = every site yt-dlp supports.
ALLOWED_HOSTS=
# Direct media links and pages with embedded players (yt-dlp's "generic"
# extractor). Only active while EGRESS_PROXY is on.
ENABLE_GENERIC_EXTRACTOR=true

# --- Egress proxy (network-level SSRF protection) ---------------------------
# Every connection yt-dlp/ffmpeg make goes through a local proxy that blocks
# private, loopback, link-local and cloud-metadata addresses (after its own DNS
# lookup, pinned to the vetted IP). Keep this on.
EGRESS_PROXY=true
EGRESS_ALLOWED_PORTS=80,443
# Netscape cookies.txt if YouTube starts demanding sign-in from your server IP.
# Must be readable by the service user; each yt-dlp run gets a private copy.
YTDLP_COOKIES_FILE=
YTDLP_JS_RUNTIME=           # e.g. "deno" (default auto-detect) — deno is sandboxed, preferred
YTDLP_USER_AGENT=
YTDLP_CONCURRENT_FRAGMENTS=4
